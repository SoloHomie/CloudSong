    // ---- 块朝向 (格坐标镜像; 镜像保持槽位序, 卡在四种朝向里始终是同一槽位) ----
    // 模板 = (col + row*2) % 4 (相邻块不同款); 镜像 = 坐标哈希 (场不显网格感 — 参照 mixBlockCoords 原样移植)
    // 2026-10-14 排版"不够乱"根因: 原弱哈希 (col*73856093)^(row*19349663) 的低 2 位只取决于
    // (col%4, row%4) —— 73856093 ≡ 1、19349663 ≡ 3 (mod 4) —— 整场朝向 4×4 周期复读 (实测列 0..11 全 [0,5,10,15])
    function reflectRect(r, m) {
        var x = (m & 1) === 1 ? blockCols - r[0] - r[2] : r[0]
        var y = (m & 2) === 2 ? blockRows - r[1] - r[3] : r[1]
        return [x, y, r[2], r[3]]
    }
    function mixBlockCoords(col, row) {
        var v = Math.imul(col, 0x9e3779b1) ^ Math.imul(row, 0x85ebca6b)
        v = Math.imul(v ^ (v >>> 15), 0x2c1b3c6d)
        v ^= v >>> 12
        return v >>> 0
    }
    function blockOrientation(col, row) {
        var t = ((col + row * 2) % 4 + 4) % 4
        return t * 4 + mixBlockCoords(col, row) % 4
    }

    // 四种朝向展开的模板/让位表 (16 套, 静态预计算)
    readonly property var orientedTemplates: (function () {
        var out = []
        for (var t = 0; t < 4; ++t) {
            for (var m = 0; m < 4; ++m) {
                var arr = []
                for (var i = 0; i < templates[t].length; ++i)
                    arr.push(reflectRect(templates[t][i], m))
                out.push(arr)
            }
        }
        return out
    })()
    readonly property var orientedReflows: (function () {
        var out = []
        for (var t = 0; t < 4; ++t) {
            for (var m = 0; m < 4; ++m) {
                var perSlot = []
                for (var s = 0; s < 12; ++s) {
                    var arr = []
                    for (var i = 0; i < 12; ++i)
                        arr.push(reflectRect(reflows[t][s][i], m))
                    perSlot.push(arr)
                }
                out.push(perSlot)
            }
        }
        return out
    })()

    // 格矩形 [x,y,w,h] → 世界矩形 (块原点 + 格×步距; 宽高减缝)
    function worldRect(blockCol, blockRow, r) {
        return { x: blockCol * blockCols * pitch + r[0] * pitch,
                 y: blockRow * blockRows * pitch + r[1] * pitch,
                 w: r[2] * pitch - gap,
                 h: r[3] * pitch - gap }
    }

    // 展开槽位时, 同块 12 张的新矩形 (世界坐标; 下标 = 磁贴原槽位, 展开那张是 6×6)
    function blockReflowRects(blockCol, blockRow, slotIdx) {
        var table = orientedReflows[blockOrientation(blockCol, blockRow)][slotIdx]
        var out = []
        for (var i = 0; i < table.length; ++i)
            out.push(worldRect(blockCol, blockRow, table[i]))
        return out
    }

    // ---- 建块 ----
    // 单块 12 槽 (任意块坐标 — 无限墙的滑动窗口按需对任意块取数据); 序号 gi 沿用原建场口径
    // ((row+2)*4+(col+2)) * 12 + s, 原点块 (-2,-2) → 0 — 首屏与旧 20 块场逐张一致; 内容 gi mod 库表
    function blockSlots(blockCol, blockRow) {
        var slots = orientedTemplates[blockOrientation(blockCol, blockRow)]
        var out = []
        for (var s = 0; s < slots.length; ++s) {
            var wr = worldRect(blockCol, blockRow, slots[s])
            var gi = ((blockRow + 2) * 4 + (blockCol + 2)) * 12 + s
            out.push({ x: wr.x, y: wr.y, w: wr.w, h: wr.h,
                       col: blockCol, row: blockRow, slot: s,
                       key: blockCol + "," + blockRow + "," + s,
                       gi: gi,
                       item: itemFor("playlist", gi) })
        }
        return out
    }

    // gi → 内容 (块序号 × 12 + 槽位; 取模命中库表)
    function itemFor(key, gi) {
        var arr = lib[key]
        var i = ((gi % arr.length) + arr.length) % arr.length
        var e = arr[i]
        var hue = (i * 47 + key.length * 113 + key.charCodeAt(0) * 7) % 360
        return { kind: key,
                 title: e[0],
                 owner: e[1],
                 tracks: e[2],
                 hue: hue,
                 subtitle: e[2] + " 首 · " + e[1] }
    }

    // 角标文案: 「歌单 · 34」
    function badgeFor(face) {
        var lbl = face.kind === "playlist" ? "歌单"
                : face.kind === "album" ? "专辑"
                : face.kind === "artist" ? "歌手" : "本地"
        return lbl + " · " + face.tracks
    }

